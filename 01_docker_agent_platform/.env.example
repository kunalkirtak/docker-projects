# Copy this file to .env and adjust values as needed.
# .env is git-ignored; .env.example is the committed template.
# The password below is a development-only placeholder -- never reuse it
# for anything real.

APP_NAME=docker-agent-platform-api
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (reached via the "postgres" Docker Compose service name)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentdb
POSTGRES_USER=agentuser
POSTGRES_PASSWORD=agentpassword_dev_only

# Qdrant (reached via the "qdrant" Docker Compose service name)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=agent_knowledge

# Agent service (reached via the "agent" Docker Compose service name)
AGENT_SERVICE_HOST=agent
AGENT_SERVICE_PORT=8001

# Worker service (reached via the "worker" Docker Compose service name)
WORKER_SERVICE_HOST=worker
WORKER_SERVICE_PORT=8002
