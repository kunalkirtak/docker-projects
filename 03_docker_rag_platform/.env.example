# Copy this file to .env and adjust values as needed.
# .env is git-ignored and must never be committed.

# ---- PostgreSQL ----
# NOTE: the API always connects using the Docker Compose service
# name "postgres" as the hostname, not "localhost". Docker Compose's
# internal DNS resolves "postgres" to the postgres container's
# internal IP address inside the rag_network.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword

# ---- Qdrant ----
# Same principle: "qdrant" is the Compose service name, resolved via
# Docker's internal DNS — not "localhost".
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ---- Embeddings ----
EMBEDDING_DIM=128
